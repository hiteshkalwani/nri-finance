{
  "name": "nri-finance",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @nri/api dev\" \"pnpm --filter @nri/web dev\"",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test:unit": "pnpm -r run test",
    "test:integration": "pnpm -r run test:int",
    "stack:keys": "node scripts/stack-keys.mjs",
    "stack:up": "node scripts/stack.mjs up",
    "stack:check": "node scripts/stack.mjs check",
    "stack:down": "node scripts/stack.mjs down",
    "stack:reset": "node scripts/stack.mjs reset",
    "db:generate": "pnpm --filter @nri/db generate",
    "db:migrate": "pnpm --filter @nri/db migrate",
    "build:vercel": "node scripts/vercel-build.mjs",
    "test:e2e": "playwright test",
    "test:scripts": "node --test 'scripts/*.test.mjs'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nri/test-utils": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
